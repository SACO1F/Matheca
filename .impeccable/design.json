  "narrative": {
    "northStar": "The Quiet Mathematics Workspace",
    "overview": "A neutral gray shell holds a clear white work area. Soft question surfaces, graphite or restrained colored primary controls, quiet secondary tools and coherent spacing let mathematics lead. This supports sustained teacher work organizing questions, assembling collections and exporting exercises.\n\nThe user chose simplicity and harmonious composition, citing Codex as a quality reference. Matheca retains its own name and mathematics workflow. The previous paper-white and green identity and three generic direction prototypes were explicitly rejected. Local interface fonts and existing local KaTeX assets keep the workspace self-contained.",
    "keyCharacteristics": [
      "Neutral reading surfaces with optional restrained accents and independent semantic warning and error colors.",
      "Content-first question cards and quiet repeated actions.",
      "Compact icon navigation and consistent curved controls.",
      "Flat resting surfaces, soft elevation for floating layers."
    ],
    "rules": [
      {
        "name": "The Restrained Accent Rule",
        "body": "Indicate selection with the chosen soft fill, accent ink and border changes; keep ordinary reading surfaces neutral and preserve semantic state colors.",
        "section": "colors"
